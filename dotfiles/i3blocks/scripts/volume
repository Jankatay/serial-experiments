#!/usr/bin/bash

# init
SYM_MUTE="" 
SYM_ZERO=" "
SYM_DOWN=" "
SYM_MIDD=" "
SYM_HIGH=" "
status="$(wpctl get-volume @DEFAULT_AUDIO_SINK@)"

# if muted, just skip
if grep -q "[MUTED]" <<< "$status"; then
  echo "$SYM_MUTE"
  exit;
fi

# otherwise get volume
current_vol="$(awk '{print $2 * 100}' <<< $status | bc)"
if (( "$current_vol" > 66 )); then
  echo -n "$SYM_HIGH"
elif (( "$current_vol" > 33 )); then
  echo -n "$SYM_MIDD"
elif (( "$current_vol" > 0 )); then
  echo -n "$SYM_DOWN"
else echo -n "$SYM_ZERO"
fi

# calculate overflows for the hidden feature
division=$(( ("$current_vol" - 1) / 100 ))
for i in `seq 1 $division`; do
  echo -n ') ';
done
echo "$current_vol%"

